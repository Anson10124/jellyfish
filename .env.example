# Optional: restrict the server-side Seerr proxy to exact comma-separated origins.
# Recommended for public deployments.
# SEERR_PROXY_ALLOWED_ORIGINS=https://seerr.example.com

# Production deployments require the allowlist above. This escape hatch permits arbitrary
# public origins and should only be used when you understand the open-proxy tradeoff.
SEERR_PROXY_ALLOW_UNLISTED_PUBLIC_ORIGINS=false

# Private, loopback, link-local, and reserved network targets are blocked by default.
# Enable only for a trusted self-hosted Jellyfish deployment that must reach Seerr on a LAN.
SEERR_PROXY_ALLOW_PRIVATE_NETWORKS=false

# Jellyfin proxy settings are independent from Seerr. Choose Proxied in the connection UI.
# Required in production unless explicitly allowing unlisted public origins below.
# JELLYFIN_PROXY_ALLOWED_ORIGINS=https://jellyfin.example.com
JELLYFIN_PROXY_ALLOW_UNLISTED_PUBLIC_ORIGINS=false

# Enable only for trusted self-hosted deployments reaching Jellyfin on a LAN.
# The Jellyfish app server must be able to reach the address, including for playback.
JELLYFIN_PROXY_ALLOW_PRIVATE_NETWORKS=false
